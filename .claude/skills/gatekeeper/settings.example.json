{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/gatekeeper/gate.py\" hook",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Gatekeeper"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/gatekeeper/gate.py\" hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
